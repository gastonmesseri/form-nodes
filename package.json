{
  "name": "@gem/ng-forms",
  "version": "0.1.0",
  "description": "Small, typed, signal-based form primitives for Angular.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "test": "vitest run",
    "test:browser": "npm run build && node scripts/create-form-node-hydration-fixture.mjs && vitest run --config vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage --coverage.include='src/lib/**/*.ts' --coverage.exclude='src/**/*.spec.ts' --coverage.exclude='src/**/*.type.ts' --coverage.thresholds.statements=100 --coverage.thresholds.branches=99 --coverage.thresholds.functions=100 --coverage.thresholds.lines=100",
    "test:package": "npm run build && node scripts/test-package-consumer.mjs",
    "test:templates": "node scripts/test-template-types.mjs",
    "test:types": "tsc -p tsconfig.type-tests.json --noEmit",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit && npm run test:types && npm run test:templates"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0"
  },
  "devDependencies": {
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.1.3",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^22.1.3",
    "@angular/platform-server": "^22.1.3",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "fast-check": "^4.3.0",
    "jsdom": "^26.1.0",
    "ng-packagr": "^22.1.0",
    "playwright": "^1.55.0",
    "typescript": "~6.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "keywords": [
    "angular",
    "forms",
    "signals",
    "typescript"
  ]
}
