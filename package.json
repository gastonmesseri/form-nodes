{
  "name": "form-nodes",
  "version": "0.1.0",
  "description": "Easy, small, typed, signal-based form primitives for Angular.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "website"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "docs:build": "npm --workspace website run build",
    "docs:start": "npm --workspace website run start",
    "docs:typecheck": "npm --workspace website run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:browser": "npm run build && node scripts/create-form-node-signal-control-fixture.mjs && node scripts/create-form-node-hydration-fixture.mjs && vitest run --config vitest.browser.config.ts && vitest run --config vitest.browser.production-aot.config.ts",
    "test:coverage": "vitest run --coverage --coverage.include='src/lib/**/*.ts' --coverage.exclude='src/**/*.spec.ts' --coverage.exclude='src/**/*.fixture.ts' --coverage.exclude='src/**/*.type.ts' --coverage.thresholds.statements=100 --coverage.thresholds.branches=99 --coverage.thresholds.functions=100 --coverage.thresholds.lines=100",
    "test:package": "npm run build && node scripts/test-package-consumer.mjs",
    "test:templates": "node scripts/test-template-types.mjs",
    "test:types": "tsc -p tsconfig.type-tests.json --noEmit && node scripts/test-shorthand-type-performance.mjs",
    "test:watch": "vitest",
    "typecheck": "npm run lint && tsc -p tsconfig.spec.json --noEmit && npm run test:types && npm run test:templates",
    "test:compatibility": "node scripts/test-angular-compatibility.mjs"
  },
  "peerDependencies": {
    "@angular/core": "^21.2.22 || ^22.1.5",
    "@angular/forms": "^21.2.22 || ^22.1.5"
  },
  "devDependencies": {
    "@angular/compiler": "21.2.22",
    "@angular/compiler-cli": "21.2.22",
    "@angular/core": "21.2.22",
    "@angular/forms": "21.2.22",
    "@angular/platform-browser": "21.2.22",
    "@angular/platform-browser-dynamic": "21.2.22",
    "@angular/platform-server": "21.2.22",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "angular-eslint": "^21.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.3.0",
    "jsdom": "^26.1.0",
    "moment": "^2.30.1",
    "ng-packagr": "21.2.7",
    "playwright": "^1.55.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "keywords": [
    "angular",
    "forms",
    "signals",
    "typescript"
  ]
}
